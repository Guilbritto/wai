{
  "$schema": "https://github.com/longbridge/gpui-kit/raw/refs/heads/main/.theme-schema.json",
  "name": "wai Aurora",
  "author": "wai",
  "_ref": "central-ia-waycarbon-claude/central/www/app.css :root",
  "themes": [
    {
      "name": "wai Aurora",
      "mode": "dark",
      "radius": 10,
      "radius.lg": 16,
      "colors": {
        "background": "#070a18",
        "foreground": "#eceffe",
        "border": "#ffffff1a",
        "input.border": "#ffffff1a",
        "muted.background": "#0a0e24",
        "muted.foreground": "#8f99c2",
        "primary.background": "#36e2c0",
        "primary.foreground": "#0b1024",
        "secondary.background": "#ffffff17",
        "accent.background": "#8d72ff29",
        "ring": "#36e2c0",
        "caret": "#36e2c0",
        "selection.background": "#8d72ff59",
        "drag.border": "#8d72ff",
        "drop_target.background": "#8d72ff29",
        "link": "#5bb8ff",
        "popover.background": "#0d1230",
        "overlay": "#070a1899",
        "info.background": "#5bb8ff",
        "success.background": "#46e39a",
        "warning.background": "#ffc15a",
        "danger.background": "#ff6b8b",
        "list.background": "#00000000",
        "list.active.background": "#8d72ff29",
        "list.active.border": "#8d72ff73",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#ffffff29",
        "scrollbar.thumb.hover.background": "#626c98",
        "sidebar.background": "#00000000",
        "sidebar.accent.background": "#8d72ff29",
        "tab.background": "#00000000",
        "tab.active.background": "#8d72ff29",
        "tab.active.foreground": "#eceffe",
        "tab.foreground": "#c4cbeb",
        "tab_bar.background": "#00000000",
        "title_bar.background": "#00000000",
        "title_bar.border": "#00000000",
        "base.red": "#ff6b8b",
        "base.red.light": "#ff8fa6",
        "base.green": "#46e39a",
        "base.green.light": "#7af0b8",
        "base.blue": "#5bb8ff",
        "base.blue.light": "#8fd0ff",
        "base.yellow": "#ffc15a",
        "base.yellow.light": "#ffd38a",
        "base.magenta": "#ff6ec7",
        "base.magenta.light": "#ff9ad9",
        "base.cyan": "#36e2c0",
        "base.cyan.light": "#7ff0d8"
      },
      "highlight": {
        "editor.background": "#00000000",
        "editor.foreground": "#c4cbeb",
        "editor.active_line.background": "#ffffff0e",
        "editor.line_number": "#626c98",
        "editor.active_line_number": "#c4cbeb",
        "editor.invisible": "#ffffff29",
        "error": "#ff6b8b",
        "error.background": "#ff6b8b29",
        "error.border": "#ff6b8b",
        "warning": "#ffc15a",
        "warning.background": "#ffc15a29",
        "warning.border": "#ffc15a",
        "info": "#5bb8ff",
        "info.background": "#5bb8ff29",
        "info.border": "#5bb8ff",
        "success": "#46e39a",
        "success.background": "#46e39a29",
        "success.border": "#46e39a",
        "hint": "#8d72ff",
        "hint.background": "#8d72ff29",
        "hint.border": "#8d72ff",
        "created": "#46e39a",
        "modified": "#ffc15a",
        "deleted": "#ff6b8b",
        "syntax": {
          "attribute": { "color": "#5bb8ff" },
          "boolean": { "color": "#ffc15a" },
          "comment": { "color": "#626c98" },
          "constant": { "color": "#ffc15a" },
          "constructor": { "color": "#cbbcff" },
          "embedded": { "color": "#c4cbeb" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "enum": { "color": "#cbbcff" },
          "function": { "color": "#5bb8ff" },
          "keyword": { "color": "#8d72ff" },
          "label": { "color": "#ff6ec7" },
          "link_text": { "color": "#5bb8ff" },
          "link_uri": { "color": "#36e2c0", "font_style": "italic" },
          "number": { "color": "#ffc15a" },
          "operator": { "color": "#8f99c2" },
          "preproc": { "color": "#ff6ec7" },
          "property": { "color": "#c4cbeb" },
          "punctuation": { "color": "#8f99c2" },
          "punctuation.list_marker": { "color": "#ff8f4f" },
          "punctuation.special": { "color": "#ff6ec7" },
          "string": { "color": "#36e2c0" },
          "string.escape": { "color": "#ff6ec7" },
          "string.regex": { "color": "#ff6ec7" },
          "tag": { "color": "#ff6ec7" },
          "text.code.span": { "color": "#36e2c0" },
          "text.literal": { "color": "#36e2c0" },
          "title": { "color": "#ff8f4f", "font_weight": 700 },
          "type": { "color": "#cbbcff" },
          "variable.special": { "color": "#ff6ec7" },
          "variant": { "color": "#cbbcff" }
        }
      }
    }
  ]
}
